# StationerySort Environment Configuration Example

# Flask Server Port
FLASK_PORT=5001
FLASK_HOST=127.0.0.1
FLASK_DEBUG=1

# SQLite Database Location
DATABASE_PATH=stationery.db

# Ollama Host & Open-Weight Gemma Model
# Recommended open-weight models: gemma4:12b, gemma2:2b, gemma:2b, or gemma2:9b
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:12b
OLLAMA_TIMEOUT=40.0
